# 複製為 .env。本機模擬不會連線 Google，也不會真的交件。
MODE=mock
PORT=3000
MOCK_PASSWORD=1234
# 正式環境請產生至少32字元隨機值，不可使用此範例。
SESSION_SECRET=local-development-only-change-before-deploy
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_DIR=./data
DRIVE_FOLDER_ID=your_shared_drive_folder_id
SPREADSHEET_ID=your_spreadsheet_id
LOG_SHEET=工作表1
PASSWORD_RANGE='工作表2'!A2
# 正式模式 MODE=google；JSON 金鑰放專案外或 Render Secret File。
# GOOGLE_APPLICATION_CREDENTIALS=D:/private/service-account.json
# Render 只信任平台提供的最右側 X-Forwarded-For，設為 1。
TRUST_PROXY=0
